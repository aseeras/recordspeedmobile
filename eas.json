{
  "cli": {
    "version": ">= 8.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.recordspeed.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.recordspeed.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "gchertok@ingsw.com",
        "ascAppId": "6502834346",
        "appleTeamId": "6X9Y9NQZR3"
      },
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
