{
  "cli": {
    "version": ">= 8.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.recordspeed.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.recordspeed.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.recordspeed.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "G3A4C87SVV"
      },
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
